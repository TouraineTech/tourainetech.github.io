---
import { siteConfig } from '@data/config/site';
import { sponsoringCampaign } from '@data/config/sponsoring';
import { showSponsoringCta } from '@lib/phase';

const { sponsoringUrl, sponsoringBrochureUrl } = siteConfig;
const { offers, deadline, contactEmail } = sponsoringCampaign;
const priceFormat = new Intl.NumberFormat('fr-FR');
const steps = [
  { title: 'Choisissez votre formule', text: 'Consultez le dossier et indiquez la formule souhaitée dans le formulaire.' },
  { title: 'Formalisons le partenariat', text: 'Nous vous adressons une convention à signer, puis la facture correspondante.' },
  { title: 'Préparons votre visibilité', text: 'Transmettez-nous votre logo vectoriel, votre lien et vos offres d’emploi.' },
];
---

{showSponsoringCta && (
  <section class="become-sponsor" id="become-sponsor" aria-labelledby="offers-title">
    <div class="partnership-inner">
      <header class="offers-header">
        <div>
          <span class="section-label">Les formules</span>
          <h2 id="offers-title">À chaque entreprise, sa place.</h2>
        </div>
        <p>Tarifs pour les deux jours.<br />TVA non applicable.</p>
      </header>

      <div class="offers-grid">
        {offers.map((offer) => (
          <article class:list={['offer', `offer-${offer.name.toLowerCase()}`]} aria-labelledby={`offer-${offer.name.toLowerCase()}`}>
            <div class="offer-heading">
              <h3 id={`offer-${offer.name.toLowerCase()}`}>{offer.name}</h3>
              {offer.name === 'Gold' && (
                <span class="offer-emblem" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                    <path d="m12 2.5 2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96L12 2.5Z" />
                  </svg>
                </span>
              )}
              <p class="offer-availability">{offer.availability}</p>
            </div>
            <p class="offer-price">{priceFormat.format(offer.price)}<span> €</span></p>
            <p class="offer-description">{offer.description}</p>
            <ul>
              {offer.features.map((feature) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="offers-note">Les principales prestations sont présentées ici. Consultez le dossier pour le détail de chaque formule et les modalités de réservation.</p>

      <div class="partnership-actions">
        <div class="actions-copy">
          <h3>Faisons connaissance.</h3>
          <p>Les engagements sont ouverts jusqu’au <strong>{deadline}</strong>.</p>
        </div>
        <div class="actions-buttons">
          {sponsoringBrochureUrl && (
            <a href={sponsoringBrochureUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Consulter le dossier
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v7H3V3h7" /></svg>
            </a>
          )}
          <a href={sponsoringUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Devenir sponsor
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <div class="partnership-process">
        <h2>Et ensuite ?</h2>
        <ol class="partnership-steps">
          {steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="partnership-contact">Une question sur les formules ? <a href={`mailto:${contactEmail}`}>Écrivez à l’équipe →</a></p>
      </div>
    </div>
  </section>
)}

<style>
  .become-sponsor { padding: var(--section-padding); background: var(--bg-primary); }
  .partnership-inner { max-width: 1100px; margin: 0 auto; }
  .offers-header { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; }
  .offers-header h2 { margin-top: .65rem; font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .offers-header > p { flex-shrink: 0; color: var(--text-secondary); font-size: .85rem; line-height: 1.7; text-align: right; }
  .offers-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .offer { --tier-color: #80533b; padding: 1.75rem; border: 1px solid var(--glass-border); border-top: 3px solid var(--tier-color); border-radius: 16px; background: var(--bg-primary); }
  .offer-silver { --tier-color: #626c7a; }
  .offer-gold { --tier-color: #87691d; background: #fcfbf6; }
  .offer-heading { position: relative; }
  .offer-heading h3 { color: var(--tier-color); font-size: 1.15rem; }
  .offer-gold .offer-heading { padding-right: 3rem; }
  .offer-emblem { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #f3ecd8; color: var(--tier-color); }
  .offer-availability { color: var(--text-secondary); font-size: .75rem; margin-top: .25rem; }
  .offer-price { margin: 1.5rem 0 .75rem; font-family: var(--font-display); font-size: 2.75rem; font-weight: 600; line-height: 1; letter-spacing: -.04em; }
  .offer-price span { font-size: 1.5rem; font-weight: 400; }
  .offer-description { min-height: 3.2rem; color: var(--text-secondary); font-size: .9rem; line-height: 1.65; }
  .offer ul { display: grid; gap: .85rem; list-style: none; margin: 1.5rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid var(--glass-border); }
  .offer li { display: flex; align-items: baseline; gap: .6rem; font-size: .85rem; line-height: 1.65; }
  .offer li svg { flex: 0 0 16px; align-self: start; margin-top: .2rem; color: var(--accent-dark); }
  .offers-note { color: var(--text-secondary); font-size: .8rem; line-height: 1.7; margin-top: 1rem; }
  .partnership-actions { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2rem; padding: 2rem; border-radius: 16px; background: var(--accent-light); }
  .actions-copy h3 { font-size: 1.5rem; margin-bottom: .4rem; }
  .actions-copy p { font-size: .85rem; color: var(--text-secondary); }
  .actions-buttons { display: flex; flex-shrink: 0; gap: .75rem; }
  .actions-buttons .btn { font-size: .9rem; }
  .partnership-process { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--glass-border); }
  .partnership-process > h2 { font-size: 1.75rem; margin-bottom: 1.75rem; }
  .partnership-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; list-style: none; padding: 0; }
  .step-number { display: block; color: var(--accent-dark); font-size: .85rem; font-weight: 600; margin-bottom: .6rem; }
  .partnership-steps h3 { font-size: 1.05rem; margin-bottom: .6rem; }
  .partnership-steps p { font-size: .9rem; line-height: 1.75; color: var(--text-secondary); }
  .partnership-contact { margin-top: 2rem; font-size: .9rem; color: var(--text-secondary); }
  .partnership-contact a { color: var(--accent-dark); font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 1024px) {
    .offer { padding: 1.25rem; }
    .partnership-actions { flex-direction: column; align-items: start; gap: 1.25rem; }
  }
  @media (max-width: 767px) {
    .offers-header { flex-direction: column; align-items: start; gap: 1rem; }
    .offers-header > p { text-align: left; }
    .offers-grid, .partnership-steps { grid-template-columns: 1fr; }
    .offer { padding: 1.5rem; }
    .offer-description { min-height: 0; }
    .offer-price { margin-top: 1.25rem; }
    .partnership-actions { padding: 1.5rem; }
    .actions-buttons { flex-direction: column; width: 100%; }
    .partnership-process { margin-top: 3rem; padding-top: 2rem; }
  }
</style>
