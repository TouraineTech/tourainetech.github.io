---
import { siteConfig } from '@data/config/site';
import { getAllSponsors } from '@lib/data';
import { hasSponsors, showSponsoringCta, isPost } from '@lib/phase';

const sponsors = getAllSponsors();
---

{(hasSponsors || showSponsoringCta) && (
  <section class="sponsors-block" id="sponsors" aria-labelledby="sponsoring-title">
    <div class="sponsors-inner">
      {showSponsoringCta ? (
        <div class="sponsoring-invitation">
          <div class="sponsoring-heading">
            <span class="sponsoring-eyebrow">Partenaires {siteConfig.edition.year}</span>
            <h2 id="sponsoring-title">Votre entreprise a sa place <span>à Touraine Tech.</span></h2>
          </div>
          <div class="sponsoring-copy">
            <p class="sponsoring-intro">
              Rencontrez la communauté tech, partagez votre expertise
              et soutenez un événement local.
            </p>
            <ul class="sponsoring-benefits" aria-label="Les bénéfices du partenariat">
              <li>Visibilité</li>
              <li>Rencontres</li>
              <li>Partage</li>
            </ul>
            <a href="/sponsors" class="btn btn-primary">
              Découvrir le sponsoring
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ) : (
        <h2 id="sponsoring-title" class="partners-title">
          {isPost ? 'Merci à nos partenaires' : 'Ils rendent Touraine Tech possible'}
        </h2>
      )}

      {hasSponsors && (
        <div class="confirmed-partners">
          {showSponsoringCta && <p class="partners-label">Ils nous font déjà confiance</p>}
          <div class="partner-logos">
            {sponsors.map((sponsor) => (
              <a href={`/sponsor/${sponsor.id}`} class="partner-logo" title={sponsor.name}>
                <img src={`/img/sponsors/${sponsor.image}`} alt={sponsor.name} loading="lazy" />
              </a>
            ))}
          </div>
          <a href="/sponsors" class="partners-link">Découvrir tous nos partenaires →</a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .sponsors-block { padding: var(--section-padding); background: var(--bg-primary); }
  .sponsors-inner { max-width: 1100px; margin: 0 auto; }
  .sponsoring-invitation { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: clamp(2rem, 5vw, 4rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 24px; border: 1px solid var(--glass-border); background: #edf6f3; color: var(--text-primary); }
  .sponsoring-heading, .sponsoring-copy { min-width: 0; }
  .sponsoring-eyebrow { display: inline-block; color: var(--accent-dark); font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .sponsoring-heading h2 { color: var(--text-primary); font-size: clamp(2rem, 3.8vw, 3rem); line-height: 1.12; margin: 1rem 0 0; letter-spacing: -.025em; text-wrap: balance; }
  .sponsoring-heading h2 span { display: block; color: var(--accent-dark); }
  .sponsoring-intro { font-size: 1.05rem; line-height: 1.75; color: var(--text-secondary); }
  .sponsoring-benefits { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; list-style: none; padding: 0; margin: 1.5rem 0 2rem; font-size: .85rem; font-weight: 600; color: var(--accent-dark); }
  .sponsoring-benefits li { display: flex; align-items: center; gap: .5rem; }
  .sponsoring-benefits li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .sponsoring-copy .btn { background: var(--accent-dark); color: #fff; border-color: transparent; box-shadow: none; }
  .sponsoring-copy .btn:hover { background: #245e51; }
  .sponsoring-copy .btn:focus-visible { outline: 3px solid var(--accent-dark); outline-offset: 5px; }
  .partners-title, .confirmed-partners { text-align: center; }
  .sponsoring-invitation + .confirmed-partners { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--glass-border); }
  .partners-label { font-size: .9rem; color: var(--text-secondary); }
  .partner-logos { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem; margin: 1.5rem 0; }
  .partner-logo { display: flex; align-items: center; justify-content: center; padding: .75rem 1.25rem; border-radius: 10px; background: var(--bg-tertiary); }
  .partner-logo img { max-height: 44px; max-width: 120px; object-fit: contain; }
  .partners-link { color: var(--accent-dark); font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 767px) {
    .sponsoring-invitation { grid-template-columns: 1fr; gap: 1.5rem; padding: 2rem 1.5rem; border-radius: 20px; }
    .sponsoring-heading h2 { font-size: clamp(1.9rem, 7vw, 2.65rem); }
  }
  @media (max-width: 420px) { .sponsoring-copy .btn { width: 100%; } }
</style>
