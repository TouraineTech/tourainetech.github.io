---
// Bloc sponsors COMPACT de la home : argumentaire -> preuve (logos) -> CTA.
// Deux axes independants pilotent le rendu (cf. plan) :
//   hasSponsors      -> affiche les logos ("Ils nous font deja confiance")
//   showSponsoringCta -> affiche l'argumentaire commercial + CTA
import { siteConfig } from '@data/config/site';
import { getAllSponsors } from '@lib/data';
import { hasSponsors, showSponsoringCta, isPost } from '@lib/phase';

const { sponsoringUrl } = siteConfig;
const sponsors = getAllSponsors();

// Titre adapte a l'etat
const heading = showSponsoringCta
  ? 'Faites rayonner votre marque devant ceux qui comptent'
  : isPost
    ? 'Merci a nos partenaires'
    : 'Ils rendent Touraine Tech possible';
---

<section class="sponsors-block" id="sponsors">
  <div class="sponsors-block-inner">
    <div class="sb-header">
      <span class="sb-eyebrow">Sponsors</span>
      <h2 class="sb-title">{heading}</h2>
      {showSponsoringCta && (
        <p class="sb-subtitle">
          Visibilite, recrutement et temps de parole devant la communaute tech du Centre-Val de Loire.
        </p>
      )}
    </div>

    {hasSponsors && (
      <>
        {showSponsoringCta && <p class="sb-proof">Ils nous font deja confiance</p>}
        <div class="sb-logos">
          {sponsors.map((sponsor: any) => (
            <a href={`/sponsor/${sponsor.id}`} class="sb-logo" title={sponsor.name}>
              <img src={`/img/sponsors/${sponsor.image}`} alt={sponsor.name} loading="lazy" />
            </a>
          ))}
        </div>
      </>
    )}

    <div class="sb-actions">
      {showSponsoringCta && (
        <a href={sponsoringUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Decouvrir les offres
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      )}
      {hasSponsors && (
        <a href="/sponsors" class="btn btn-secondary">Decouvrir tous nos partenaires</a>
      )}
    </div>
  </div>
</section>

<style>
  .sponsors-block {
    padding: var(--section-padding);
    background: var(--bg-primary);
  }

  .sponsors-block-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .sb-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }

  .sb-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    max-width: 720px;
    margin: 0 auto;
    letter-spacing: -0.02em;
  }

  .sb-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 1rem auto 0;
    line-height: 1.6;
  }

  .sb-proof {
    margin: 2.5rem 0 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .sb-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
  }

  .sb-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    background: var(--bg-tertiary);
    border-radius: 10px;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .sb-logo:hover,
  .sb-logo:focus-visible {
    background: var(--bg-secondary);
    transform: translateY(-2px);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sb-logo img {
    max-height: 44px;
    max-width: 120px;
    object-fit: contain;
  }

  .sb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
</style>
