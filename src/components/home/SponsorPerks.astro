---
// Grille des benefices sponsoring (partagee par SponsorsBlock (home) et
// BecomeSponsor (/sponsors)) : l'argumentaire qui donne envie de sponsoriser.
const perks = [
  {
    icon: '📣',
    title: 'Visibilité maximale',
    desc: 'Votre logo partout : site, réseaux, goodies, signalétique.',
    highlight: 'Logo omniprésent',
  },
  {
    icon: '🎯',
    title: 'Recrutement direct',
    desc: 'Un stand dédié pour rencontrer les talents. Votre prochain dev est peut-être dans la salle.',
    highlight: 'Stand dédié',
  },
  {
    icon: '🎤',
    title: 'Temps de parole',
    desc: 'Présentez votre stack, vos projets, votre vision. Les devs vous écoutent.',
    highlight: 'Slots dédiés',
  },
  {
    icon: '🌱',
    title: 'Impact local',
    desc: "Soutenez l'écosystème tech du Centre-Val de Loire. Contribuez au rayonnement de la région.",
    highlight: 'Écosystème régional',
  },
];
---

<div class="perks-grid">
  {perks.map((perk, index) => (
    <article class="perk-card" style={`--index: ${index}`}>
      <div class="perk-icon-wrapper">
        <span class="perk-icon" aria-hidden="true">{perk.icon}</span>
      </div>
      <div class="perk-content">
        <h3 class="perk-title">{perk.title}</h3>
        <p class="perk-desc">{perk.desc}</p>
      </div>
      <span class="perk-highlight">{perk.highlight}</span>
    </article>
  ))}
</div>

<style>
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align: left;
  }

  .perk-card {
    background: var(--bg-primary, #fff);
    border: 1px solid var(--glass-border, rgba(0, 0, 0, 0.08));
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.06));
  }

  .perk-icon-wrapper {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent) 8%, white);
    border-radius: 14px;
  }

  .perk-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .perk-content {
    flex: 1;
  }

  .perk-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .perk-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .perk-highlight {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--accent) 10%, white);
    border-radius: 100px;
  }

  @media (max-width: 768px) {
    .perks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
