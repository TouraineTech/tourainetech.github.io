---
import Layout from '@layouts/Layout.astro';
import SponsorsPreview from '@components/home/SponsorsPreview.astro';
import BecomeSponsor from '@components/home/BecomeSponsor.astro';
import { hasSponsors } from '@lib/phase';
---

<Layout
  title="Sponsors & Partenaires"
  description="Les partenaires qui rendent Touraine Tech possible, leurs offres d'emploi, et comment devenir sponsor."
>
  <header class="sponsors-hero">
    <div class="sponsors-hero-inner">
      <span class="hero-eyebrow">Partenaires</span>
      <h1>Ils rendent Touraine Tech possible</h1>
      <p>
        Merci aux entreprises qui soutiennent la communaute tech du Centre-Val de Loire.
        Retrouvez leurs fiches et leurs offres d'emploi.
      </p>
    </div>
  </header>

  {hasSponsors ? (
    <SponsorsPreview showHeader={false} />
  ) : (
    <p class="sponsors-empty">Les partenaires seront annonces prochainement.</p>
  )}

  <BecomeSponsor />
</Layout>

<style>
  .sponsors-hero {
    background: linear-gradient(135deg, var(--accent, #6abfad) 0%, var(--accent-dark, #4a9284) 100%);
    padding: 5rem 2rem;
    text-align: center;
  }

  .sponsors-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 100px;
    margin-bottom: 1rem;
  }

  .sponsors-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  .sponsors-hero p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  .sponsors-empty {
    text-align: center;
    color: var(--text-secondary);
    padding: 4rem 1.5rem;
  }
</style>
