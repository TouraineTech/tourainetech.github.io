---
import Layout from '@layouts/Layout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import StatsSection from '@components/home/StatsSection.astro';
import CategoriesSection from '@components/home/CategoriesSection.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import GallerySection from '@components/home/GallerySection.astro';
import SponsorsPreview from '@components/home/SponsorsPreview.astro';
import BecomeSponsor from '@components/home/BecomeSponsor.astro';
import MapSection from '@components/home/MapSection.astro';
import NewsletterSection from '@components/home/NewsletterSection.astro';
import { siteConfig, testimonials } from '@data/config/site';
import photosData from '@data/generated/photos.json';

// Rendu conditionnel selon la phase / la disponibilite du contenu
const hasTestimonials = testimonials.length > 0;
const hasPhotos = (photosData as unknown[]).length > 0;
const { isSponsoringOpen } = siteConfig;
---

<Layout>
  <HeroSection />
  <StatsSection />
  <CategoriesSection />
  {hasTestimonials && <TestimonialsSection />}
  {hasPhotos && <GallerySection />}
  <SponsorsPreview />
  {isSponsoringOpen && <BecomeSponsor />}
  <MapSection />
  <NewsletterSection />
</Layout>
