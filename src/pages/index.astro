---
import Layout from '@layouts/Layout.astro';
import EventStructuredData from '@components/seo/EventStructuredData.astro';
import HeroSection from '@components/home/HeroSection.astro';
import StatsSection from '@components/home/StatsSection.astro';
import CategoriesSection from '@components/home/CategoriesSection.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import SpeakersPreview from '@components/home/SpeakersPreview.astro';
import ProgramPreview from '@components/home/ProgramPreview.astro';
import GallerySection from '@components/home/GallerySection.astro';
import SponsorsBlock from '@components/home/SponsorsBlock.astro';
import MapSection from '@components/home/MapSection.astro';
import NewsletterSection from '@components/home/NewsletterSection.astro';
import { testimonials } from '@data/config/site';
import photosData from '@data/generated/photos.json';
import { isIntro, isSponsoring, isCfp, isTicketing, isProgramme, isPost } from '@lib/phase';

// Composition pilotee par la phase (cf. plan) : ossature stable, importance
// des contenus qui glisse. L'edition precedente descend a mesure que
// l'edition courante devient concrete.
const hasTestimonials = testimonials.length > 0;
const hasPhotos = (photosData as unknown[]).length > 0;
const isPreEventCampaign = isCfp || isTicketing;
---

<Layout>
  <EventStructuredData slot="head" />
  <HeroSection />
  <StatsSection />

  {isIntro && (
    <>
      {hasPhotos && <GallerySection />}
      <CategoriesSection />
      <MapSection />
    </>
  )}

  {isSponsoring && (
    <>
      <SponsorsBlock />
      {hasPhotos && <GallerySection />}
      <CategoriesSection />
      <MapSection />
    </>
  )}

  {isPreEventCampaign && (
    <>
      <SponsorsBlock />
      <CategoriesSection />
      {hasTestimonials && <TestimonialsSection />}
      {hasPhotos && <GallerySection />}
      <MapSection />
    </>
  )}

  {isProgramme && (
    <>
      <SpeakersPreview />
      <ProgramPreview />
      <SponsorsBlock />
      <MapSection />
      {hasPhotos && <GallerySection />}
    </>
  )}

  {isPost && (
    <>
      {hasPhotos && <GallerySection />}
      <SponsorsBlock />
    </>
  )}

  <NewsletterSection />
</Layout>
